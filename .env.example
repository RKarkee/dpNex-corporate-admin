# ---------------------------------------------------------------------------
# Upstream DpNEx API, including the version segment.
# ---------------------------------------------------------------------------

# Server-only. The gateway route attaches the bearer token here, so this value
# must never be exposed to the browser. Do NOT prefix it with NEXT_PUBLIC_.
API_BASE_URL=https://api.dpnex.com/api/v1

# Browser-visible. Used ONLY by `publicApiClient`, for endpoints that need no
# authentication. Usually the same URL as above.
NEXT_PUBLIC_API_BASE_URL=https://api.dpnex.com/api/v1

# Optional. Milliseconds before a request is abandoned as unreachable.
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=20000
